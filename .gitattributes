# Auto detect text files and perform LF normalization
* text=auto
ffmpeg.exe filter=lfs diff=lfs merge=lfs -text
# Build manifests hash these upstream license files byte-for-byte.
Assets/Plugins/MajdataPlay/FFmpeg/Native/**/*.LICENSE.txt text eol=lf
Assets/Plugins/MajdataPlay/FFmpeg/Native/**/COPYING.GPLv[23] text eol=lf
# The AMF capability marker includes this source patch's byte-for-byte SHA256.
Tools/FFmpeg/patches/*.patch text eol=lf
Assets/Plugins/MajdataPlay/FFmpeg/Native/**/*.patch text eol=lf
