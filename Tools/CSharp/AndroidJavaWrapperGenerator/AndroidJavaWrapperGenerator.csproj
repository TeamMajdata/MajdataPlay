<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>AndroidJavaWrapperGenerator</AssemblyName>
    <RootNamespace>MajdataPlay.Tools.AndroidJavaWrapperGenerator</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>9.0</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <NuGetAudit>false</NuGetAudit>
    <RestoreSources>$(MSBuildThisFileDirectory)</RestoreSources>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Templates/**/*.txt" WithCulture="false" />
    <InternalsVisibleTo Include="AndroidJavaWrapperGeneratorValidation" />
  </ItemGroup>
</Project>
