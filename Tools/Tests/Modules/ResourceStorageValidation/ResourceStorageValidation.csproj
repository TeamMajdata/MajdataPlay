<Project>
  <PropertyGroup>
    <MobileStorageTarget Condition="'$(MobileStorageTarget)' == ''">iOS</MobileStorageTarget>
    <BaseIntermediateOutputPath>../../../../Temp/ResourceStorageValidation/obj/$(MobileStorageTarget)/</BaseIntermediateOutputPath>
    <OutputPath>../../../../Temp/ResourceStorageValidation/bin/$(MobileStorageTarget)/</OutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RestoreSources>$(MSBuildThisFileDirectory)</RestoreSources>
    <NuGetAudit>false</NuGetAudit>
    <DefineConstants>$(DefineConstants);UNITY_STANDALONE_WIN</DefineConstants>
    <DefineConstants Condition="'$(MobileStorageTarget)' == 'iOS'">$(DefineConstants);UNITY_IOS</DefineConstants>
    <DefineConstants Condition="'$(MobileStorageTarget)' == 'Android'">$(DefineConstants);UNITY_ANDROID</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../../Assets/Plugins/MajdataPlay/IO/Storage/*.cs" Link="Production/%(Filename)%(Extension)" />
    <Compile Include="../../../../Assets/Scripts/Misc/Base/ProgressReporter.cs" Link="Production/ProgressReporter.cs" />
    <Compile Include="../../../../Assets/Scripts/Misc/ResourceUpdate/*.cs" Exclude="../../../../Assets/Scripts/Misc/ResourceUpdate/FrameBudget.cs;../../../../Assets/Scripts/Misc/ResourceUpdate/ResourceManifestLoader.cs" Link="Production/%(Filename)%(Extension)" />
    <Compile Include="../../../../Assets/Scripts/Utils/StorageDirectoryTransfer.cs" Link="Production/StorageDirectoryTransfer.cs" />
    <Compile Include="../FileSystemValidation/MemoryFileSystem.cs" Link="Doubles/MemoryFileSystem.cs" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
