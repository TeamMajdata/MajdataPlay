<Project Sdk="Microsoft.NET.Sdk">
  <!-- The ManagedBass core library, built like its NuGet package ManagedBass. -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <AssemblyName>ManagedBass</AssemblyName>
    <RootNamespace>ManagedBass</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ManagedBassSource)Bass/Portable/**/*.cs" Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <!-- EnumExtensions uses System.Runtime.CompilerServices.Unsafe, which .NET Standard 2.0 does not include. -->
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" />
  </ItemGroup>
</Project>
