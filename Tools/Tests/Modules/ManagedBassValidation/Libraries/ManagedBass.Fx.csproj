<Project Sdk="Microsoft.NET.Sdk">
  <!-- The ManagedBass FX add-on, built like its NuGet package ManagedBass.Fx. -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <AssemblyName>ManagedBass.Fx</AssemblyName>
    <RootNamespace>ManagedBass.Fx</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ManagedBassSource)AddOns/BassFx/**/*.cs" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <ProjectReference Include="ManagedBass.csproj" />
  </ItemGroup>
</Project>
