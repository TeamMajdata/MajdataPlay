<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath>../../../../Temp/BassHttpStreamValidation/obj/</BaseIntermediateOutputPath>
    <OutputPath>../../../../Temp/BassHttpStreamValidation/bin/</OutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Select the Windows C long width and native CA branches used by the Windows player. -->
    <DefineConstants>UNITY_STANDALONE;UNITY_STANDALONE_WIN</DefineConstants>
    <RestoreSources>$(MSBuildThisFileDirectory)</RestoreSources>
    <NuGetAudit>false</NuGetAudit>
    <!-- ManagedBass and the curl sources predate nullable annotations; the file under test is annotated. -->
    <NoWarn>CS0649;CS0169;CS0414;CS0618;CS1591;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8612;CS8625;CS8632</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../../Assets/Scripts/IO/Base/Audio/BassHttpFileSource.cs" Link="Production/BassHttpFileSource.cs" />
    <Compile Include="../../../../Assets/Plugins/ManagedBass/src/Bass/Portable/**/*.cs" Link="Production/ManagedBass/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../../../Assets/Plugins/MajdataPlay/Net/Curl/**/*.cs" Link="Production/Curl/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../../../Assets/Plugins/MajdataPlay/Net/Handlers/CurlHttpMessageHandler.cs" Link="Production/CurlHttpMessageHandler.cs" />
    <Compile Include="../../../../Assets/Plugins/MajdataPlay/Buffers/PooledArray.cs" Link="Production/PooledArray.cs" />
    <Compile Include="../../../../Assets/Plugins/MajdataPlay/UnsafeKit/UnsafeHelper.cs" Link="Production/UnsafeHelper.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../../../Assets/Plugins/Un4seen.Bass/Windows/bass.dll" Link="bass.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../../Assets/Plugins/MajdataPlay/Net/Curl/Plugins/Windows/x86_64/libcurl.dll" Link="libcurl.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
