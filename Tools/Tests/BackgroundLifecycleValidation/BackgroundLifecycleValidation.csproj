<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath>../../../Temp/BackgroundLifecycleValidation/obj/</BaseIntermediateOutputPath>
    <OutputPath>../../../Temp/BackgroundLifecycleValidation/bin/</OutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RestoreSources>$(MSBuildThisFileDirectory)</RestoreSources>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Assets/Scripts/Scenes/Game/BGManager.cs" Link="Production/BGManager.cs" />
    <Compile Include="../../../Assets/Scripts/Misc/Base/Majdata.cs" Link="Production/Majdata.cs" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
