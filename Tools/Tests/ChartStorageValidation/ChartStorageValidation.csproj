<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath>../../../Temp/ChartStorageValidation/obj/</BaseIntermediateOutputPath>
    <OutputPath>../../../Temp/ChartStorageValidation/bin/</OutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RestoreSources>$(MSBuildThisFileDirectory)</RestoreSources>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Assets/Plugins/MajdataPlay/IO/Storage/*.cs" Link="Production/Storage/%(Filename)%(Extension)" />
    <Compile Include="../../../Assets/Scripts/Misc/Base/ChartSettingStorage.cs" Link="Production/ChartSettingStorage.cs" />
    <Compile Include="../../../Assets/Scripts/Misc/Collections/SongCollection.cs" Link="Production/SongCollection.cs" />
    <Compile Include="../../../Assets/Scripts/Misc/Base/Enums/ChartStorageType.cs" Link="Production/ChartStorageType.cs" />
    <Compile Include="../../../Assets/Scripts/Misc/Settings/Runtime/Enums/SortType.cs" Link="Production/SortType.cs" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
