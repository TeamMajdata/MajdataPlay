<Project>
  <PropertyGroup>
    <WarmupValidationTarget Condition="'$(WarmupValidationTarget)' == ''">Android</WarmupValidationTarget>
    <BaseIntermediateOutputPath>../../../Temp/ShaderWarmupValidation/obj/$(WarmupValidationTarget)/</BaseIntermediateOutputPath>
    <OutputPath>../../../Temp/ShaderWarmupValidation/bin/$(WarmupValidationTarget)/</OutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RestoreSources>$(MSBuildThisFileDirectory)</RestoreSources>
    <NuGetAudit>false</NuGetAudit>
    <DefineConstants Condition="'$(WarmupValidationTarget)' == 'Android'">$(DefineConstants);UNITY_ANDROID</DefineConstants>
    <DefineConstants Condition="'$(WarmupValidationTarget)' == 'Editor'">$(DefineConstants);UNITY_ANDROID;UNITY_EDITOR</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Assets/Scripts/Rendering/ShaderWarmupDiagnostics.cs" Link="Production/ShaderWarmupDiagnostics.cs" />
    <Compile Include="../../../Assets/Plugins/MajdataPlay/IO/Storage/*.cs" Link="Production/Storage/%(Filename)%(Extension)" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
