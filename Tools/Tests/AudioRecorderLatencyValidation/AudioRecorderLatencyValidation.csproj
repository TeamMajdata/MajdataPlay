<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath>../../../Temp/AudioRecorderLatencyValidation/obj/</BaseIntermediateOutputPath>
    <OutputPath>../../../Temp/AudioRecorderLatencyValidation/bin/</OutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Select the WASAPI and ASIO probes compiled into the Windows player. -->
    <DefineConstants>UNITY_STANDALONE;UNITY_STANDALONE_WIN</DefineConstants>
    <RestoreSources>$(MSBuildThisFileDirectory)</RestoreSources>
    <NuGetAudit>false</NuGetAudit>
    <!-- ManagedBass predates nullable annotations; the files under test are annotated. -->
    <NoWarn>CS0649;CS0169;CS0414;CS0618;CS1591;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8612;CS8625;CS8632</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Assets/Scripts/IO/Base/Audio/BassAudioRecorder.cs" Link="Production/BassAudioRecorder.cs" />
    <Compile Include="../../../Assets/Scripts/IO/Base/Audio/BassOutputLatencyProbe.cs" Link="Production/BassOutputLatencyProbe.cs" />
    <Compile Include="../../../Assets/Scripts/IO/Base/Audio/IAudioRecorder.cs" Link="Production/IAudioRecorder.cs" />
    <Compile Include="../../../Assets/Scripts/IO/Base/Audio/AudioSampleRingBuffer.cs" Link="Production/AudioSampleRingBuffer.cs" />
    <Compile Include="../../../Assets/Plugins/ManagedBass/src/Bass/Portable/**/*.cs" Link="Production/ManagedBass/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../../Assets/Plugins/ManagedBass/src/AddOns/BassMix/**/*.cs" Link="Production/BassMix/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../../Assets/Plugins/ManagedBass/src/AddOns/BassWasapi/**/*.cs" Link="Production/BassWasapi/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../../Assets/Plugins/ManagedBass/src/AddOns/BassAsio/**/*.cs" Link="Production/BassAsio/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../../Assets/Plugins/Un4seen.Bass/Windows/bass.dll" Link="bass.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../Assets/Plugins/Un4seen.Bass/Windows/bassmix.dll" Link="bassmix.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../Assets/Plugins/Un4seen.Bass/Windows/basswasapi.dll" Link="basswasapi.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../Assets/Plugins/Un4seen.Bass/Windows/bassasio.dll" Link="bassasio.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
