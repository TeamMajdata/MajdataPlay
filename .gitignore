# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/untitled folder/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Ss]ongs/
/[Mm]ai[Cc]harts/
/[Ss]kins/
#/Assets/Plugin/
/Assets/i18n
/settings.json
/ModSettings.json
/MajDatabase.db.db.db.db.db.db.db.db.db.db.db.db.db.db.db.db.db.db.db.db.db.db.db.db.db.db.db.db
/MajScores.db
# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
#/[Aa]ssets/[Ss]treamingAssets/MaiCharts/*
/[Aa]ssets/[Ss]treamingAssets/settings.json
/[Aa]ssets/[Ss]prites/[Gg]ame/[Nn]otes/*
/[Aa]ssets/[Ss]prites/[Gg]ame/[Tt]extSprites/*
/MajPlayRuntime.log
Assets/Font/GenJyuuGothicX-Medium SDF.asset
Assets/Font/SourceHanSans-Medium SDF.asset
Assets/Font/GenJyuuGothicScore.asset
/.idea/.idea.MajdataPlay/.idea
/Cache/*
/.vscode

# FFmpeg Output Log
out.log
/RecordOutputs
/ChartSetting.db
/android-publish.keystore
*.slnx
/machine_description.json
/ExtStreamingAssets

/.idea/*
/.continue/agents

!/Tools/CSharp/AndroidJavaGenerator/AndroidJavaGenerator.csproj
# .NET build output of the Tools/CSharp tools is always local.
/Tools/CSharp/**/bin/
/Tools/CSharp/**/obj/
!/Tools/Tests/AndroidJavaGeneratorValidation/AndroidJavaGeneratorValidation.csproj
/Assets/Plugins/MajdataPlay/Platform/Android/MajdataPlay.SourceGenerators.AndroidJava.dll.meta

# Independent storage validation harness (not a Unity-generated project).
!/Tools/Tests/FileSystemValidation/FileSystemValidation.csproj
!/Tools/Tests/ChartStorageValidation/ChartStorageValidation.csproj
!/Tools/Tests/ResourceStorageValidation/ResourceStorageValidation.csproj

# Independent libcurl HTTP handler validation harness; builds into Temp/CurlValidation.
!/Tools/Tests/CurlValidation/CurlValidation.csproj

# Temporary shader warmup crash-probe validation; builds into Temp/ShaderWarmupValidation.
!/Tools/Tests/ShaderWarmupValidation/ShaderWarmupValidation.csproj

# Independent MRP camera capture bridge validation; builds into Temp/MrpCaptureValidation.
!/Tools/Tests/MrpCaptureValidation/MrpCaptureValidation.csproj

# Independent background material lifecycle validation; builds into Temp/BackgroundLifecycleValidation.
!/Tools/Tests/BackgroundLifecycleValidation/BackgroundLifecycleValidation.csproj

# Independent recorder lifecycle validation; builds into Temp/RecorderLifecycleValidation.
!/Tools/Tests/RecorderLifecycleValidation/RecorderLifecycleValidation.csproj

# Independent BASS HTTP stream validation harness; builds into Temp/BassHttpStreamValidation.
!/Tools/Tests/BassHttpStreamValidation/BassHttpStreamValidation.csproj

# Independent full Java API wrapper CLI and its validation harness.
!/Tools/CSharp/AndroidJavaWrapperGenerator/AndroidJavaWrapperGenerator.csproj
!/Tools/Tests/AndroidJavaWrapperGeneratorValidation/AndroidJavaWrapperGeneratorValidation.csproj
/Tools/Tests/AndroidJavaWrapperGeneratorValidation/bin/
/Tools/Tests/AndroidJavaWrapperGeneratorValidation/obj/
/Tools/Tests/AndroidJavaWrapperGeneratorValidation/.work/

# Generated Java bindings compile in an independent project before Unity imports its DLL.
!/Tools/AndroidJavaWrapper/AndroidJavaWrapper.csproj
/Tools/AndroidJavaWrapper/bin/
/Tools/AndroidJavaWrapper/obj/
/Tools/AndroidJavaWrapper/.work/
/Tools/AndroidJavaWrapper/AndroidJavaWrapper.local.props
/Tools/AndroidJavaWrapper/src/**/*.g.cs
/Tools/AndroidJavaWrapper/src/AndroidJni.cs
/Tools/AndroidJavaWrapper/src/IJavaObject.cs
/Tools/AndroidJavaWrapper/src/JavaInvocationException.cs
/Tools/AndroidJavaWrapper/src/JavaObjectReference.cs
/Tools/AndroidJavaWrapper/src/java-wrappers.manifest.json
/Tools/AndroidJavaWrapper/src/.java-wrappers.publication.json
/Tools/AndroidJavaWrapper/src/JavaWrapperConverter.cs
/Tools/AndroidJavaWrapper/src/JavaWrapperConverter.Exceptions.cs
/Tools/AndroidJavaWrapper/src/AndroidJavaObjectExtensions.cs
/Tools/AndroidJavaWrapper/src/JavaObjectExtensions.cs
/Tools/AndroidJavaWrapper/src/**/*.meta
!/Tools/AndroidJavaWrapper/src/**/*.e.cs.meta
/Tools/CSharp/AndroidJavaWrapperGenerator/.work/
