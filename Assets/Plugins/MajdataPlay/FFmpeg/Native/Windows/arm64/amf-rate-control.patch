--- a/libavcodec/amfenc.c
+++ b/libavcodec/amfenc.c
@@ -49,6 +49,86 @@
 #include <dlfcn.h>
 #endif
 
+/* Shared internal helpers; public FFmpeg headers and decoder paths are unchanged. */
+int ff_amf_set_rate_control_property(AVCodecContext *avctx, const wchar_t *name,
+                                    AMF_VARIANT_TYPE type, amf_int64 value);
+int ff_amf_check_rate_control(AVCodecContext *avctx,
+                             const wchar_t *const names[7], amf_int64 peak);
+
+/* Critical rate-control properties must survive AMF initialization unchanged. */
+static int amf_check_rate_control_property(AVCodecContext *avctx,
+                                         const wchar_t *name,
+                                         AMF_VARIANT_TYPE type,
+                                         amf_int64 expected)
+{
+    AMFEncoderContext *ctx = avctx->priv_data;
+    AMFVariantStruct actual = { 0 };
+    AMF_RESULT result;
+    int ret = 0;
+
+    result = ctx->encoder->pVtbl->GetProperty(ctx->encoder, name, &actual);
+    if (result != AMF_OK) {
+        av_log(avctx, AV_LOG_ERROR, "GetProperty(%ls) failed with error %d\n", name, result);
+        ret = AVERROR_EXTERNAL;
+    } else if (actual.type != type ||
+               (type == AMF_VARIANT_BOOL ?
+                (actual.boolValue != 0) != (expected != 0) :
+                actual.int64Value != expected)) {
+        av_log(avctx, AV_LOG_ERROR, "AMF changed rate-control property %ls (expected type %d, value %lld; got type %d, value %lld)\n",
+               name, type, (long long)expected, actual.type,
+               (long long)(actual.type == AMF_VARIANT_BOOL ? actual.boolValue :
+                           actual.type == AMF_VARIANT_INT64 ? actual.int64Value : -1));
+        ret = AVERROR_EXTERNAL;
+    }
+    AMFVariantClear(&actual);
+    return ret;
+}
+
+int ff_amf_set_rate_control_property(AVCodecContext *avctx, const wchar_t *name,
+                                    AMF_VARIANT_TYPE type, amf_int64 value)
+{
+    AMFEncoderContext *ctx = avctx->priv_data;
+    AMFVariantStruct requested = { 0 };
+    AMF_RESULT result;
+
+    result = type == AMF_VARIANT_BOOL ? AMFVariantAssignBool(&requested, value != 0) :
+                                       AMFVariantAssignInt64(&requested, value);
+    if (result == AMF_OK)
+        result = ctx->encoder->pVtbl->SetProperty(ctx->encoder, name, requested);
+    AMFVariantClear(&requested);
+    if (result != AMF_OK) {
+        av_log(avctx, AV_LOG_ERROR, "SetProperty(%ls) failed with error %d\n", name, result);
+        return AVERROR_EXTERNAL;
+    }
+    return amf_check_rate_control_property(avctx, name, type, value);
+}
+
+/* Property order: mode, VBV size/fullness, target, peak, HRD, filler. */
+int ff_amf_check_rate_control(AVCodecContext *avctx,
+                             const wchar_t *const names[7], amf_int64 peak)
+{
+    AMFEncoderContext *ctx = avctx->priv_data;
+    amf_int64 values[7] = { ctx->rate_control_mode, avctx->rc_buffer_size, 0,
+                           avctx->bit_rate, peak, ctx->enforce_hrd, ctx->filler_data };
+    int i, ret;
+
+    if (avctx->rc_buffer_size && avctx->rc_initial_buffer_occupancy)
+        values[2] = FFMIN((int64_t)avctx->rc_initial_buffer_occupancy * 64 / avctx->rc_buffer_size, 64);
+    for (i = 0; i < 7; i++) {
+        if ((i == 1 && !avctx->rc_buffer_size) ||
+            (i == 2 && (!avctx->rc_buffer_size || !avctx->rc_initial_buffer_occupancy)) ||
+            (i == 3 && !avctx->bit_rate) || (i == 4 && !peak) ||
+            (i >= 5 && values[i] == -1))
+            continue;
+        ret = amf_check_rate_control_property(avctx, names[i],
+                                             i >= 5 ? AMF_VARIANT_BOOL : AMF_VARIANT_INT64,
+                                             values[i]);
+        if (ret < 0)
+            return ret;
+    }
+    return 0;
+}
+
